# ==============================================================================
# SELF-CORRECTIVE & ADAPTIVE AGENTIC RAG (CRAG + SELF-RAG) CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM PROVIDER (GROQ - High Speed & Generous Free Tier)
# ------------------------------------------------------------------------------
# Get your free Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative fast models: llama-3.1-8b-instant, mixtral-8x7b-32768

# ------------------------------------------------------------------------------
# 2. FREE HUGGING FACE EMBEDDINGS & CROSS-ENCODER RERANKING
# ------------------------------------------------------------------------------
# Runs locally for 100% free embeddings without rate limits:
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# Optional HuggingFace Token (only needed for private or gated models):
HUGGINGFACE_API_KEY=

# ------------------------------------------------------------------------------
# 3. POSTGRESQL + PGVECTOR DATABASE SETTINGS
# ------------------------------------------------------------------------------
# >>> USER INSERTION MARKER: ENTER YOUR POSTGRESQL CREDENTIALS HERE <<<
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_SSLMODE=disable

# Vector store backend mode:
# 'auto'   : Checks if PostgreSQL + pgvector is reachable; connects to it.
#            If PostgreSQL is offline, gracefully falls back to local ChromaDB.
# 'postgres': Strictly enforces PostgreSQL + pgvector.
# 'chroma'  : Uses local persistent ChromaDB.
VECTOR_STORE_BACKEND=auto

# ------------------------------------------------------------------------------
# 4. PGADMIN CONFIGURATION (Docker Compose)
# ------------------------------------------------------------------------------
# >>> USER INSERTION MARKER: ENTER PGADMIN CREDENTIALS HERE <<<
PGADMIN_DEFAULT_EMAIL=admin@rag.local
PGADMIN_DEFAULT_PASSWORD=admin_secret
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# 5. WEB SEARCH TOOL (FALLBACK FOR CRAG AMBIGUOUS / INSUFFICIENT DOCS)
# ------------------------------------------------------------------------------
# By default, DuckDuckGo is enabled with ZERO API keys required!
# Optional: Provide Tavily API key if you prefer Tavily search
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 6. CRAG & SELF-RAG GUARDRAIL THRESHOLDS
# ------------------------------------------------------------------------------
# Document relevance grading threshold (0.0 to 1.0)
CRAG_RELEVANCE_THRESHOLD=0.6
# Maximum hallucination / regeneration self-correction loops
MAX_RETRIES=2
# Top-k vector chunks to retrieve
RETRIEVAL_TOP_K=4

# ------------------------------------------------------------------------------
# 7. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
DEBUG=true
